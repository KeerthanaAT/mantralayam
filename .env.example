# Copy to .env for local overrides (the app reads .env at start; real environment variables win). Never commit .env or put real secrets in this file.
# Every variable is optional: the app runs locally without any of them. For a public server see docs/DEPLOYMENT.md (it uses /etc/mantralayam/env instead).

# Paths (defaults shown)
MANTRALAYAM_DB=.tmp/mantralayam.db
MANTRALAYAM_BACKUPS=backups

# Staff password hashing: rounds accepted for older hashes
STAFF_LEGACY_ROUNDS=200000

# ---- Production: HTTPS behind a reverse proxy (deploy/Caddyfile or deploy/nginx.conf) ----
# MANTRALAYAM_HTTPS=1            # Secure cookies + HSTS; the guest app refuses to start with SMS_PROVIDER=mock
# TRUST_PROXY=1                  # read the visitor's address and https from the proxy's X-Forwarded-* headers
# TRUSTED_PROXIES=127.0.0.1,::1
# ALLOWED_HOSTS=rooms.example.org,staff.example.org
# STAFF_URL=https://staff.example.org/staff     # the staff login link in the guest site's menu and footer

# ---- Phone OTP (SMS provider interface: mock prints the code to the console, development only) ----
# SMS_HOURLY_LIMIT=60            # most code SMS the whole site sends per hour (default 60). Past it nothing is sent and the staff get an alert
# SMS_DAILY_LIMIT=300            # ... and per day (default 300). Size these to a busy day plus some room; they cap what an SMS-pumping attack can cost
# SMS_ALLOWED_PREFIXES=+91       # countries whose numbers may get a code (comma separated; default +91, India only)
# BOOKING_OTP_REQUIRED=1         # 0 lets bookings through without a code (only until SMS works)
SMS_PROVIDER=mock
# SMS_HTTP_URL=https://sms-gateway.example/send   # SMS_PROVIDER=http posts {"to", "message", "sender"} with a bearer token
# SMS_HTTP_TOKEN=
# SMS_SENDER_ID=

# ---- Email (alerts to staff): mock prints to the console and .tmp/outbox.log ----
EMAIL_PROVIDER=mock
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mantralayam Rooms <alerts@example.org>
# STAFF_ALERT_EMAILS=owner@example.org,manager@example.org

# ---- Optional CAPTCHA on public forms, on top of the honeypot (off when empty) ----
# CAPTCHA_PROVIDER=turnstile     # turnstile (Cloudflare) or mock (a tick box, for testing)
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=

# ---- Staff two-factor sign-in (authenticator app) ----
# TOTP_REQUIRED=1                # default 1 when MANTRALAYAM_HTTPS=1, else 0. Managers and super admins must set it up before they can do anything else

# ---- Abuse limits ----
# LOOKUP_FAIL_LIMIT=8            # wrong booking ID + mobile pairs per mobile number per hour, from all addresses together (default 8)
# HOLD_GLOBAL_PERCENT=50         # no new room hold while this share of all rooms is already on hold (default 50)

# ---- Health and alerts ----
# HEALTH_BACKUP_MAX_HOURS=30     # /health fails when the newest backup is older (0: do not check backups, e.g. on a development machine)
# HOLD_ALERT_PERCENT=25          # alert when this share of all rooms is on hold at once
# HOLD_LAPSE_ALERT=20            # alert when this many holds expire unbooked within an hour
# HEARTBEAT_URL=https://hc-ping.com/your-uuid   # pinged after every successful 5-minute job (python tools/mantralayam_rooms.py tick)

# ---- WhatsApp (same message as the SMS; off when empty) ----
# WHATSAPP_PROVIDER=mock         # mock | http (generic gateway: POST {to, message, sender}, bearer token)
# WHATSAPP_HTTP_URL=https://whatsapp-gateway.example/send
# WHATSAPP_HTTP_TOKEN=
# WHATSAPP_SENDER=

# ---- Online payments: UPI, cards, net banking through Razorpay (off when PAYMENT_PROVIDER is empty) ----
# PAYMENT_PROVIDER=mock          # mock = a fake checkout window on the local guest site, no money (refused when MANTRALAYAM_HTTPS=1); razorpay = real, use rzp_test_ keys for test mode
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=       # the secret you type in Razorpay > Webhooks; URL https://<guest host>/api/public/payment/webhook (events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed)

# ---- Report export to Google Sheets (a service account; off when these are empty and the page downloads a CSV instead) ----
# GOOGLE_SERVICE_ACCOUNT_JSON=/etc/mantralayam/service-account.json   # the key file's path, or the JSON text itself. Share the spreadsheet with the account's client_email (Editor).
# GOOGLE_SHEETS_ID=              # the long id in the spreadsheet's address
# SHEETS_PROVIDER=               # empty = google when both are set; mock = keep exports in memory (tests); signing needs the 'cryptography' package or the openssl command line tool

# ---- Links in messages ----
# PUBLIC_URL=https://rooms.example.org   # the guest site's address, used in feedback, unsubscribe and email-confirmation links (default http://127.0.0.1:8001)

# ---- Secrets that protect stored data ----# ---- Secrets that protect stored data ----
# ID_ENCRYPTION_KEY=             # REQUIRED on a public server (MANTRALAYAM_HTTPS=1): 32+ random characters kept outside the database (python3 -c "import secrets; print(secrets.token_urlsafe(32))"). Encrypts guest ID documents, staff two-factor secrets and pending-payment details. Losing it makes them unreadable.
# APP_SECRET=                    # REQUIRED on a public server: signs the check-in QR codes. Without it the secret sits in the database, and so in every backup

# Add one line here for each external service as it is built (payments, WhatsApp, Google Sheets, maps).
# Each service reads its keys from the environment and has a mock mode, so leaving them empty must still run the app.
