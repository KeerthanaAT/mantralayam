# Two services from one template: mantralayam@rooms (guest site, port 8001) and mantralayam@staff (staff app, port 8002).
#   sudo cp deploy/mantralayam.service /etc/systemd/system/mantralayam@.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now mantralayam@rooms mantralayam@staff
# Settings come from /etc/mantralayam/env (see .env.example); it holds secrets, so keep it readable by root and the service user only.
[Unit]
Description=Mantralayam Rooms (%i)
After=network.target

[Service]
User=mantralayam
Group=mantralayam
WorkingDirectory=/opt/mantralayam-rooms
EnvironmentFile=/etc/mantralayam/env
ExecStart=/usr/bin/python3 /opt/mantralayam-rooms/tools/mantralayam_%i.py serve
Restart=on-failure
RestartSec=3
# The service may write only to its data folders
NoNewPrivileges=true
# Files this service creates (backups, the database journal) are readable by the service user only
UMask=0077
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mantralayam /var/backups/mantralayam
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
